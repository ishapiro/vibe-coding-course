# Copy to .env for local development (never commit .env)
#
# Required for admin/station APIs (server-side only).
# For production deployments, set these as secrets on the Worker
# (e.g. wrangler secret put NUXT_ADMIN_PASSWORD).

NUXT_ADMIN_PASSWORD=
NUXT_STATION_PASSWORD=

# Optional: email when an order becomes "ready" (server-side only)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
